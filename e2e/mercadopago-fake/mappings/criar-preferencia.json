{
  "request": {
    "method": "POST",
    "urlPath": "/checkout/preferences",
    "headers": {
      "Authorization": { "matches": "Bearer .+" }
    }
  },
  "response": {
    "status": 201,
    "headers": { "Content-Type": "application/json" },
    "body": "{\"id\": \"pref-{{jsonPath request.body '$.external_reference'}}\", \"init_point\": \"https://www.mercadopago.com.br/checkout/v1/redirect?pref_id=pref-{{jsonPath request.body '$.external_reference'}}\", \"external_reference\": \"{{jsonPath request.body '$.external_reference'}}\"}",
    "transformers": ["response-template"]
  }
}
