{
  "request": {
    "method": "GET",
    "urlPathPattern": "/v1/payments/aprovado-[0-9a-f-]{36}",
    "headers": {
      "Authorization": { "matches": "Bearer .+" }
    }
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "body": "{\"id\": \"{{request.pathSegments.[2]}}\", \"status\": \"approved\", \"status_detail\": \"accredited\", \"external_reference\": \"{{substring request.pathSegments.[2] 9}}\", \"payment_type_id\": \"bank_transfer\", \"transaction_amount\": 100000.00}",
    "transformers": ["response-template"]
  }
}
