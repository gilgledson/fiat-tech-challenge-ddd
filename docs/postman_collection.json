					"name": "16. Obter Fatura por OS ID (JSON)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 404 || pm.response.code === 500) {",
									"    if (!pm.collectionVariables.get(\"fatura_retry_count\")) {",
									"        pm.collectionVariables.set(\"fatura_retry_count\", 1);",
									"    } else {",
									"        var count = parseInt(pm.collectionVariables.get(\"fatura_retry_count\"));",
									"        pm.collectionVariables.set(\"fatura_retry_count\", count + 1);",
									"    }",
									"    ",
									"    if (parseInt(pm.collectionVariables.get(\"fatura_retry_count\")) <= 5) {",
									"        console.log(\"Fatura não encontrada, tentando novamente em 1s... Tentativa \" + pm.collectionVariables.get(\"fatura_retry_count\"));",
									"        postman.setNextRequest(pm.info.requestName);",
									"    } else {",
									"        pm.test(\"Fatura Encontrada após retentativas\", () => pm.response.to.be.success);",
									"    }",
									"} else {",
									"    var res = pm.response.json();",
									"    pm.collectionVariables.set(\"fatura_retry_count\", 0);",
									"    pm.collectionVariables.set(\"fatura_id\", res.id);",
									"    pm.test(\"Fatura Encontrada\", () => pm.response.to.be.success);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
