				{
					"name": "9.1. Obter Orcamento por OS ID (JSON)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 404 || pm.response.code === 500) {",
									"    if (!pm.collectionVariables.get(\"orcamento_retry_count\")) {",
									"        pm.collectionVariables.set(\"orcamento_retry_count\", 1);",
									"    } else {",
									"        var count = parseInt(pm.collectionVariables.get(\"orcamento_retry_count\"));",
									"        pm.collectionVariables.set(\"orcamento_retry_count\", count + 1);",
									"    }",
									"    ",
									"    if (parseInt(pm.collectionVariables.get(\"orcamento_retry_count\")) <= 5) {",
									"        console.log(\"Orcamento não encontrada, tentando novamente em 1s... Tentativa \" + pm.collectionVariables.get(\"orcamento_retry_count\"));",
									"        postman.setNextRequest(pm.info.requestName);",
									"    } else {",
									"        pm.test(\"Orcamento Encontrada após retentativas\", () => pm.response.to.be.success);",
									"    }",
									"} else {",
									"    var res = pm.response.json();",
									"    pm.collectionVariables.set(\"orcamento_retry_count\", 0);",
									"    pm.collectionVariables.set(\"orcamento_id\", res.id);",
									"    pm.test(\"Orcamento Gerada no Diagnóstico\", () => pm.response.to.be.success);",
									"    pm.test(\"Valor do Orçamento\", () => pm.expect(res.valorTotal).to.equal(635.0));",
									"}"
								],
								"type": "text/javascript"
							}
						}
